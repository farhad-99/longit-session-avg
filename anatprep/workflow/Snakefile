"""
Within-subject longitudinal session averaging workflow.

Implements trim → subject-template → session coregistration for two MRI
modalities: TOF angiography and T2w.
"""

import os
import glob


_config_path = os.path.normpath(
    os.path.join(workflow.basedir, "..", "config", "snakebids.yml")
)
print(f"[longitudinal] config: {_config_path}")
configfile: _config_path


bids_dir = config["bids_dir"]
output_dir = config["output_dir"]

# {"TOF": "acq-TOF_run-1_angio", "T2w": "run-1_T2w"}
modality_patterns = config["modalities"]
modalities = list(modality_patterns.keys())


def _discover_subject_sessions(bids_dir):
    """Return dict mapping subject -> sorted list of sessions by globbing BIDS dir."""
    subject_sessions = {}
    for ses_path in sorted(
        glob.glob(os.path.join(bids_dir, "sub-*", "ses-*", "anat"))
    ):
        parts = ses_path.split(os.sep)
        sub = parts[-3].replace("sub-", "")
        ses = parts[-2].replace("ses-", "")
        subject_sessions.setdefault(sub, []).append(ses)
    return subject_sessions


subject_sessions = _discover_subject_sessions(bids_dir)
subjects = list(subject_sessions.keys())

print(f"[longitudinal] bids_dir: {bids_dir}")
print(f"[longitudinal] Discovered {len(subjects)} subject(s): {subjects}")
for sub, sessions in subject_sessions.items():
    print(f"[longitudinal]   sub-{sub}: {len(sessions)} session(s) {sessions}")


def get_sessions(subject):
    return subject_sessions.get(subject, [])


def resolve_modality_nii(subject, session, modality):
    """Glob for the session's image matching the modality keyword.

    Tolerant of BIDS entity variations (run numbers, extra acq tags, etc.)
    since it matches on a substring keyword rather than an exact suffix.
    """
    anat_dir = os.path.join(bids_dir, f"sub-{subject}", f"ses-{session}", "anat")
    keyword = modality_patterns[modality]
    pattern = os.path.join(anat_dir, f"sub-{subject}_ses-{session}_*{keyword}*.nii.gz")
    matches = sorted(glob.glob(pattern))
    if not matches:
        raise FileNotFoundError(
            f"No file matching modality '{modality}' (keyword '{keyword}') "
            f"found in {anat_dir} (pattern: {pattern})"
        )
    if len(matches) > 1:
        raise ValueError(
            f"Multiple files matched modality '{modality}' (keyword '{keyword}') "
            f"in {anat_dir}: {matches}"
        )
    return matches[0]


wildcard_constraints:
    modality="|".join(modalities),


